From 974b5ad5724d2eb41a35704e5b0cddd55e308d06 Mon Sep 17 00:00:00 2001
From: Rostyslav Lesovyi <rostyslav.lesovyi@globallogic.com>
Date: Thu, 12 Mar 2026 16:15:44 +0200
Subject: [PATCH] fixed selection of the node when multiple nodes have the same
 local interfaces

---
 ieee1905-core/src/topology_manager.rs | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/ieee1905-core/src/topology_manager.rs b/ieee1905-core/src/topology_manager.rs
index 09fb34c..f4674eb 100644
--- a/ieee1905-core/src/topology_manager.rs
+++ b/ieee1905-core/src/topology_manager.rs
@@ -354,9 +354,7 @@ impl Ieee1905DeviceData {
         if self.destination_mac == Some(mac) {
             return true;
         }
-        self.local_interface_list
-            .as_ref()
-            .is_some_and(|e| e.iter().any(|e| e.mac == mac))
+        false
     }
 }
 
@@ -1149,7 +1147,6 @@ mod tests {
 
         assert!(db.find_device_by_port(device_mac).await.is_some());
         assert!(db.find_device_by_port(device_al_mac).await.is_some());
-        assert!(db.find_device_by_port(device_if_mac).await.is_some());
         assert!(db
             .find_device_by_port(MacAddr::new(0, 0, 0, 0, 0, 4))
             .await
-- 
